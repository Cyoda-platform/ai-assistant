{
  "type": "object",
  "required": ["name", "version", "fields"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Entity name in camelCase"
    },
    "version": {
      "type": "string",
      "default": "1"
    },
    "description": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["string", "integer", "boolean", "date", "array", "object", "float", "decimal"]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "description": {
            "type": "string"
          },
          "enum": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "target"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"]
          },
          "target": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}

