                "calculationNodesTags": "ai_assistant",
                "responseTimeoutMs": 300000
              }
            }
          ]
        },
        {
          "name": "rollback",
          "next": "deployed_app",
          "manual": true,
          "processors": [
            {
              "name": "MessageProcessor.message_deployment_rollback_c4f9",
              "executionMode": "ASYNC_NEW_TX",
